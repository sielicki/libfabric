@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@)
  set(_libfabric_saved_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
  foreach(_dependency IN ITEMS @LIBFABRIC_DEPENDENCIES@)
    find_dependency(${_dependency})
  endforeach()
  set(CMAKE_MODULE_PATH "${_libfabric_saved_module_path}")
  unset(_libfabric_saved_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LibfabricTargets.cmake")
check_required_components(Libfabric)
